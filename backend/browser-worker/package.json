{
  "name": "@helm/browser-worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@helm/observability": "workspace:*",
    "@helm/shared": "workspace:*",
    "@hono/node-server": "^1.14.3",
    "@types/ws": "^8.18.2",
    "dotenv": "^16.5.0",
    "hono": "^4.7.10",
    "pino": "^9.7.0",
    "playwright": "^1.52.0",
    "ws": "^8.23.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
