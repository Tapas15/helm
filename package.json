{
    "name": "helm",
    "private": true,
    "packageManager": "pnpm@9.15.4",
    "scripts": {
        "dev": "turbo dev",
        "build": "turbo build",
        "lint": "turbo lint",
        "typecheck": "turbo typecheck",
        "test": "turbo test",
        "format": "prettier --write .",
        "db:generate": "pnpm --filter @helm/db db:generate",
        "db:migrate": "pnpm --filter @helm/db db:migrate",
        "db:push": "pnpm --filter @helm/db db:push",
        "db:seed": "pnpm --filter @helm/db db:seed",
        "smoke:e2e": "node scripts/e2e-smoke.mjs"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.15.0",
        "globals": "^17.14.0",
        "prettier": "^3.5.3",
        "turbo": "^2.5.4",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.74.0"
    }
}
