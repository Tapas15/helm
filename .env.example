# Core
NODE_ENV=development
PORT=8787
PUBLIC_URL=http://localhost:8787
DATABASE_URL=postgres://postgres:postgres@localhost:5432/helm
REDIS_URL=redis://localhost:6379
OBJECT_STORE_ENDPOINT=http://localhost:9000
OBJECT_STORE_BUCKET=helm

# Auth/Security
HELM_REQUIRE_AUTH=0
HELM_ALLOW_DEV_AUTH=1
HELM_AUTH_DEV_USER_ID=usr_local_dev
HELM_VAULT_MASTER_KEY=dev-vault-master-key-change-me
SESSION_SECRET=dev-session-secret-change-me
ENCRYPTION_KEY=dev-encryption-key-change-me-32b

# Models (OpenAI-compatible; set HELM_MODEL_BASE_URL+HELM_MODEL for local/Ollama, or OPENAI_API_KEY for hosted)
HELM_MODEL_PROVIDER=
HELM_MODEL_BASE_URL=
HELM_MODEL=
HELM_MODEL_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Hermes
HERMES_URL=http://localhost:8080
HERMES_TOKEN=

# Browser
BROWSER_WORKER_URL=http://localhost:8790
BROWSER_WORKER_TOKEN=dev-browser-token
BROWSER_WORKER_PORT=8790

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=helm-main
HELM_TEMPORAL_ENABLED=0
HELM_TEMPORAL_MODE=off # off|external-write|all
HELM_TEMPORAL_ENABLED=0
HELM_TEMPORAL_MODE=off # off|external-write|all

# Connectors
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8787/v1/connectors/google/callback
WEB_URL=http://localhost:5173

# Worker
WORKER_POLL_MS=2000
WORKER_LEASE_MS=30000
LOG_LEVEL=info

# Reconciliation (uncertain receipt auto-lookup, no blind retry)
HELM_RECONCILIATION_ENABLED=0
HELM_RECONCILIATION_INTERVAL_MS=60000
HELM_RECONCILIATION_OLDER_THAN_MS=60000
HELM_RECONCILIATION_LIMIT=20

HELM_GMAIL_API_BASE=https://gmail.googleapis.com
HELM_CALENDAR_API_BASE=https://www.googleapis.com
